    {
      "name": "Wallets",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "description": "Copie o \"id\" da resposta para a variável de ambiente walletId antes de rodar as próximas requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get Wallet",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{walletId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Wallet Ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/ledger?limit=50&cursor=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{walletId}}",
                "ledger"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "disabled": false
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Wallet Ledger (cursor malformado -> 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/ledger?cursor=isso-nao-e-um-cursor-valido",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{walletId}}",
                "ledger"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "isso-nao-e-um-cursor-valido",
                  "disabled": false
                }
              ]
            },
            "description": "cursor inválido (não é o base64 opaco esperado) — espera 400 RequestValidationError, não 503."
          },
          "response": []
        },
        {
          "name": "Reconciliation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/reconciliation",

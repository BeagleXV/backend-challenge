{
  "info": {
    "_postman_id": "d6f6c1a0-6b3a-4b1a-9c2e-1b7a6a2f0e11",
    "name": "Distributed Wagering Processor",
    "description": "Collection manual para testar a API do Distributed Wagering Processor. Formato Postman Collection v2.1 — importável tanto no Postman quanto no Insomnia (Import → From File).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Token (client_credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Roda primeiro. Copie o \"access_token\" da resposta para a variável de ambiente token — as pastas Wallets e Wagering Transactions já usam Bearer {{token}} automaticamente.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
